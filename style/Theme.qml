pragma Singleton
pragma ComponentBehavior: Bound

import Quickshell
import Quickshell.Io
import QtQuick

// Material 3 Expressive design tokens.
//
// Colors are generated by matugen (SchemeExpressive) from the wallpaper into
// style/Colors.json. FileView watches that file, so `matugen image ...`
// recolors the bar live, without a reload. If the file is absent, the
// Material baseline dark scheme below is used as-is.
Singleton {
    id: root

    // ---- dynamic color scheme ------------------------------------------------

    readonly property var baselineScheme: ({
        "primary": "#d0bcff",
        "on_primary": "#381e72",
        "primary_container": "#4f378b",
        "on_primary_container": "#eaddff",
        "secondary": "#ccc2dc",
        "on_secondary": "#332d41",
        "secondary_container": "#4a4458",
        "on_secondary_container": "#e8def8",
        "tertiary": "#efb8c8",
        "on_tertiary": "#492532",
        "tertiary_container": "#633b48",
        "on_tertiary_container": "#ffd8e4",
        "error": "#f2b8b5",
        "on_error": "#601410",
        "error_container": "#8c1d18",
        "on_error_container": "#f9dedc",
        "surface": "#141218",
        "on_surface": "#e6e0e9",
        "surface_variant": "#49454f",
        "on_surface_variant": "#cac4d0",
        "surface_dim": "#141218",
        "surface_bright": "#3b383e",
        "surface_container_lowest": "#0f0d13",
        "surface_container_low": "#1d1b20",
        "surface_container": "#211f26",
        "surface_container_high": "#2b2930",
        "surface_container_highest": "#36343b",
        "outline": "#938f99",
        "outline_variant": "#49454f",
        "inverse_surface": "#e6e0e9",
        "inverse_on_surface": "#322f35",
        "inverse_primary": "#6750a4",
        "scrim": "#000000",
        "shadow": "#000000"
    })

    property var scheme: baselineScheme

    FileView {
        id: colorsFile

        path: Qt.resolvedUrl("Colors.json")
        watchChanges: true
        printErrors: false

        onLoaded: root.applyGeneratedScheme()
        onTextChanged: root.applyGeneratedScheme()
    }

    // matugen emits 6-digit hex; tolerate 8-digit RRGGBBAA (QML wants AARRGGBB).
    function normalizeHex(value: string): string {
        if (value.length === 9 && value.charAt(0) === "#")
            return "#" + value.slice(7, 9) + value.slice(1, 7);
        return value;
    }

    function applyGeneratedScheme(): void {
        let data;
        try {
            data = JSON.parse(colorsFile.text());
        } catch (e) {
            console.warn("Theme: cannot parse Colors.json:", e);
            return;
        }
        const merged = Object.assign({}, root.baselineScheme);
        for (const key in data)
            merged[key] = root.normalizeHex(String(data[key]));
        root.scheme = merged;
    }

    // ---- color roles (M3) ----------------------------------------------------

    readonly property color primary: scheme.primary
    readonly property color primaryText: scheme.on_primary
    readonly property color primaryContainer: scheme.primary_container
    readonly property color primaryContainerText: scheme.on_primary_container
    readonly property color secondary: scheme.secondary
    readonly property color secondaryText: scheme.on_secondary
    readonly property color secondaryContainer: scheme.secondary_container
    readonly property color secondaryContainerText: scheme.on_secondary_container
    readonly property color tertiary: scheme.tertiary
    readonly property color tertiaryText: scheme.on_tertiary
    readonly property color tertiaryContainer: scheme.tertiary_container
    readonly property color tertiaryContainerText: scheme.on_tertiary_container
    readonly property color error: scheme.error
    readonly property color errorText: scheme.on_error
    readonly property color errorContainer: scheme.error_container
    readonly property color errorContainerText: scheme.on_error_container
    readonly property color surface: scheme.surface
    readonly property color surfaceText: scheme.on_surface
    readonly property color surfaceVariant: scheme.surface_variant
    readonly property color surfaceVariantText: scheme.on_surface_variant
    readonly property color surfaceDim: scheme.surface_dim
    readonly property color surfaceContainerLowest: scheme.surface_container_lowest
    readonly property color surfaceContainerLow: scheme.surface_container_low
    readonly property color surfaceContainer: scheme.surface_container
    readonly property color surfaceContainerHigh: scheme.surface_container_high
    readonly property color surfaceContainerHighest: scheme.surface_container_highest
    readonly property color outline: scheme.outline
    readonly property color outlineVariant: scheme.outline_variant
    readonly property color inverseSurface: scheme.inverse_surface
    readonly property color inverseOnSurface: scheme.inverse_on_surface
    readonly property color inversePrimary: scheme.inverse_primary
    readonly property color scrim: scheme.scrim

    // ---- state layers ----------------------------------------------------------

    readonly property real stateHover: 0.08
    readonly property real statePressed: 0.10

    // ---- shape scale (M3) ------------------------------------------------------

    readonly property int shapeXS: 4
    readonly property int shapeSM: 8
    readonly property int shapeMD: 12
    readonly property int shapeLG: 16
    readonly property int shapeXL: 28
    readonly property int shapeFull: 9999

    // ---- motion ----------------------------------------------------------------
    // Emphasized-family easing curves from the M3 motion spec, as cubic bezier
    // control points for `easing.bezierCurve`.

    readonly property int durShort: 150
    readonly property int durMedium: 250
    readonly property int durLong: 400

    readonly property var curveEmphasized: [0.2, 0.0, 0.0, 1.0]
    readonly property var curveEmphasizedDecelerate: [0.05, 0.7, 0.1, 1.0]
    readonly property var curveEmphasizedAccelerate: [0.3, 0.0, 0.8, 0.15]

    // ---- typography ------------------------------------------------------------

    readonly property string fontFamily: "Noto Sans"
    readonly property string iconFont: "Material Symbols Rounded"
    readonly property int fontSizeTitleLarge: 22
    readonly property int fontSizeLabelLarge: 14
    readonly property int fontSizeLabelMedium: 12

    // ---- bar metrics -----------------------------------------------------------

    readonly property int barHeight: 40
    readonly property int barMargin: 6
    readonly property int barPadding: 8
    readonly property int chipHeight: 30
    readonly property int iconButtonSize: 36
    readonly property int iconSize: 18
    readonly property int iconSizeSmall: 16
    readonly property int iconSizeLarge: 30

    // ---- Material Symbols codepoints -------------------------------------------
    // Verified against the installed MaterialSymbolsRounded variable font.

    readonly property string iconVolumeDown: "\uE04D" // volume_down
    readonly property string iconVolumeMute: "\uE04E" // volume_mute
    readonly property string iconVolumeOff: "\uE04F" // volume_off
    readonly property string iconVolumeUp: "\uE050" // volume_up
    readonly property string iconBrightnessLow: "\uE1AD" // brightness_low
    readonly property string iconBrightnessMedium: "\uE1AE" // brightness_medium
    readonly property string iconBrightnessHigh: "\uE1AC" // brightness_high
    readonly property string iconKeyboard: "\uE312" // keyboard
    readonly property string iconPower: "\uE8AC" // power_settings_new
    readonly property string iconRestart: "\uF053" // restart_alt
    readonly property string iconLogout: "\uE9BA" // logout
    readonly property string iconLock: "\uE899" // lock
    readonly property string iconSuspend: "\uE1A2" // pause_circle
    readonly property string iconHibernate: "\uF159" // bedtime
    readonly property string iconCalendar: "\uE935" // calendar_today
    readonly property string iconNotifications: "\uE7F5" // notifications
    readonly property string iconNotificationsOff: "\uE7F6" // notifications_off
    readonly property string iconClock: "\uE8B5" // schedule
    readonly property string iconMonitoring: "\uF190" // monitoring
    readonly property string iconApps: "\uE5C3" // apps
    readonly property string iconSearch: "\uE8B6" // search
    readonly property string iconClose: "\uE5CD" // close
    readonly property string iconClipboard: "\uE14F" // content_paste
    readonly property string iconImage: "\uE3F4" // image
    readonly property string iconDelete: "\uE872" // delete
    readonly property string iconDeleteForever: "\uE92B" // delete_forever
    readonly property string iconBatteryCharging: "\uE1A3" // battery_charging_full
    readonly property string iconBatteryFull: "\uE1A5" // battery_full
    readonly property var iconBatteryBars: [ // battery_0_bar .. battery_6_bar
        "\uEBDC", "\uEBD9", "\uEBE0", "\uEBDD", "\uEBE2", "\uEBD4", "\uEBD2"
    ]
    readonly property string iconWifi: "\uE63E" // wifi
    readonly property string iconWifiOff: "\uE648" // wifi_off
    readonly property string iconDnd: "\uE612" // do_not_disturb
    readonly property string iconNightlight: "\uEF5E" // nightlight
    readonly property string iconExpandMore: "\uE5CF" // expand_more
    readonly property string iconExpandLess: "\uE5CE" // expand_less
    readonly property string iconPlay: "\uE037" // play_arrow
    readonly property string iconPause: "\uE034" // pause
    readonly property string iconNext: "\uE044" // skip_next
    readonly property string iconPrevious: "\uE045" // skip_previous
    readonly property string iconMusic: "\uE3A1" // music_note
}
