    // Palette source (ShellState.colorScheme). The fixed packs are merged over
    // the baseline of the current mode, so roles they do not list keep sane
    // defaults (inverse surfaces, fixed accents) instead of the other mode's.
    readonly property var activeScheme: ShellState.colorScheme === "oled"
        ? Object.assign({}, root.activeBaseline, root.light ? root.oledLightScheme : root.oledScheme)
        : ShellState.colorScheme === "gruvbox"
        ? Object.assign({}, root.activeBaseline, root.light ? root.gruvboxLightScheme : root.gruvboxScheme)
        : root.activeM3

    readonly property var activeBaseline: root.light ? root.baselineLightScheme : root.baselineScheme
    readonly property var activeM3: root.light ? root.m3LightScheme : root.m3Scheme

    // The "new" pack layers its neutral surfaces on the wallpaper palette only;
    // a picked color scheme owns the surfaces.
    readonly property var scheme: root.glass && ShellState.colorScheme === "matugen"
        ? Object.assign({}, root.activeScheme, root.light ? root.newLightScheme : root.newScheme)
        : root.activeScheme

    // Both palette files stay watched: the dark one feeds the bar in dark mode
    // and is what triggers the light pass, the light one feeds it in light mode.
    FileView {
        id: darkColors

        path: Qt.resolvedUrl("Colors.json")
        watchChanges: true
        printErrors: false

        onLoaded: root.applyGeneratedScheme()
        onFileChanged: {
            darkColors.reload();
            lightPass.sync();
        }
        onTextChanged: root.applyGeneratedScheme()
    }

    FileView {
        id: lightColors

        path: Qt.resolvedUrl("ColorsLight.json")
        watchChanges: true
        printErrors: false

        onLoaded: root.applyGeneratedScheme()
        onFileChanged: lightColors.reload()
        onTextChanged: root.applyGeneratedScheme()
    }

    onLightChanged: {
        root.applyGeneratedScheme();
        if (root.light)
            lightPass.sync();
    }

    // matugen takes the mode from the command line only, so the light twin of
    // Colors.json is a second pass with its own config (and no wallpaper
    // command there: regenerating colors must not re-apply the wallpaper). It
    // runs when matugen rewrote the dark file after the light one — a wallpaper
    // change, or a shell start after one — and exits at once otherwise. The
    // light file is written by this pass only, so there is no loop.
    readonly property string lightPassScript: [
        "dark=" + Quickshell.env("HOME") + "/.config/quickshell/style/Colors.json",
        "light=" + Quickshell.env("HOME") + "/.config/quickshell/style/ColorsLight.json",
        "[ \"$light\" -nt \"$dark\" ] && exit 0",
        "img=$(awww query 2>/dev/null | sed -n 's/.*currently displaying: image: //p' | head -1)",
        "[ -n \"$img\" ] || exit 0",
        "exec matugen -m light image \"$img\" -c " + Quickshell.env("HOME") + "/.config/matugen/light.toml"
    ].join("\n")

    Process {
        id: lightPass

        command: ["sh", "-c", root.lightPassScript]

        function sync(): void {
            if (!lightPass.running)
                lightPass.running = true;
        }
    }

    Component.onCompleted: lightPass.sync()

    // matugen emits 6-digit hex; tolerate 8-digit RRGGBBAA (QML wants AARRGGBB).
    function normalizeHex(value: string): string {
        if (value.length === 9 && value.charAt(0) === "#")
            return "#" + value.slice(7, 9) + value.slice(1, 7);
        return value;
    }

    function applyGeneratedScheme(): void {
        const view = root.light ? lightColors : darkColors;
        const text = view.text();
        if (text.trim() === "")
            return; // not generated yet: the baseline of this mode stands
        let data;
        try {
            data = JSON.parse(text);
        } catch (e) {
            console.warn("Theme: cannot parse", view.path + ":", e);
            return;
        }
        const merged = Object.assign({}, root.activeBaseline);
        for (const key in data)
            merged[key] = root.normalizeHex(String(data[key]));
        if (root.light)
            root.m3LightScheme = merged;
        else
            root.m3Scheme = merged;
    }

