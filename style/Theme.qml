pragma Singleton
pragma ComponentBehavior: Bound

import Quickshell
import Quickshell.Io
import QtQuick
import "../services"

// Material 3 Expressive design tokens.
//
// Colors are generated by matugen (SchemeExpressive) from the wallpaper into
// style/Colors.json. FileView watches that file, so `matugen image ...`
// recolors the bar live, without a reload. If the file is absent, the
// Material baseline dark scheme below is used as-is.
//
// Two style packs share these tokens (ShellState.styleMode, switched in the
// settings menu): "m3" is the wallpaper palette above; "new" swaps in fixed
// graphite surfaces with acrylic alpha, flat text tones, a hairline edge with
// an inner rim and a neutral drop shadow, while the accents stay
// wallpaper-derived. Every style-dependent token hangs off `glass`, so the M3
// look is untouched.
//
// ShellState.colorScheme picks the palette source: "matugen" (the file above),
// "oled" (strict black/white) or "gruvbox" (Gruvbox dark). The fixed packs
// replace the "new" surfaces as well, so a picked scheme always shows.
Singleton {
    id: root

    readonly property bool glass: ShellState.styleMode === "new"

    // ---- dynamic color scheme ------------------------------------------------

    readonly property var baselineScheme: ({
        "primary": "#d0bcff",
        "on_primary": "#381e72",
        "primary_container": "#4f378b",
        "on_primary_container": "#eaddff",
        "secondary": "#ccc2dc",
        "on_secondary": "#332d41",
        "secondary_container": "#4a4458",
        "on_secondary_container": "#e8def8",
        "tertiary": "#efb8c8",
        "on_tertiary": "#492532",
        "tertiary_container": "#633b48",
        "on_tertiary_container": "#ffd8e4",
        "error": "#f2b8b5",
        "on_error": "#601410",
        "error_container": "#8c1d18",
        "on_error_container": "#f9dedc",
        "surface": "#141218",
        "on_surface": "#e6e0e9",
        "surface_variant": "#49454f",
        "on_surface_variant": "#cac4d0",
        "surface_dim": "#141218",
        "surface_bright": "#3b383e",
        "surface_container_lowest": "#0f0d13",
        "surface_container_low": "#1d1b20",
        "surface_container": "#211f26",
        "surface_container_high": "#2b2930",
        "surface_container_highest": "#36343b",
        "outline": "#938f99",
        "outline_variant": "#49454f",
        "inverse_surface": "#e6e0e9",
        "inverse_on_surface": "#322f35",
        "inverse_primary": "#6750a4",
        "scrim": "#000000",
        "shadow": "#000000",
        "surface_tint": "#d0bcff",
        "primary_fixed": "#eaddff",
        "primary_fixed_dim": "#d0bcff",
        "on_primary_fixed": "#21005d",
        "on_primary_fixed_variant": "#4f378b",
        "secondary_fixed": "#e8def8",
        "secondary_fixed_dim": "#ccc2dc",
        "on_secondary_fixed": "#1d192b",
        "on_secondary_fixed_variant": "#4a4458",
        "tertiary_fixed": "#ffd8e4",
        "tertiary_fixed_dim": "#efb8c8",
        "on_tertiary_fixed": "#31111d",
        "on_tertiary_fixed_variant": "#633b48"
    })

    property var m3Scheme: baselineScheme

    // "New" pack: near-black/graphite surfaces, soft light-gray typography and
    // muted secondary labels. Container tones carry acrylic alpha (the windows
    // blur what is behind them, see BackgroundEffect in the modules) — kept low
    // enough that the blur reads. Accents (primary/secondary/tertiary and their
    // containers) are left to matugen.
    readonly property var newScheme: ({
        "surface": "#ff0f1013",
        "on_surface": "#ffe2e4e8",
        "surface_variant": "#ff343941",
        "on_surface_variant": "#ff9aa1aa",
        "surface_dim": "#ff0c0d10",
        "surface_bright": "#ff3a3f47",
        "surface_container_lowest": "#ff0b0c0f",
        "surface_container_low": "#ff14161a",
        "surface_container": "#cc17191e",
        "surface_container_high": "#cc1c1f25",
        "surface_container_highest": "#d924282e",
        "outline": "#ff3c4149",
        "outline_variant": "#26ffffff",
        "scrim": "#ff000000",
        "shadow": "#ff000000"
    })

    // "Oled" pack: true black surfaces, white foreground and accents (strict
    // monochrome). Containers stay near-black grays so stacked cards keep
    // their layers.
    readonly property var oledScheme: ({
        "primary": "#ffffff",
        "on_primary": "#000000",
        "primary_container": "#1c1c1c",
        "on_primary_container": "#ffffff",
        "secondary": "#ffffff",
        "on_secondary": "#000000",
        "secondary_container": "#1c1c1c",
        "on_secondary_container": "#ffffff",
        "tertiary": "#ffffff",
        "on_tertiary": "#000000",
        "tertiary_container": "#1c1c1c",
        "on_tertiary_container": "#ffffff",
        "error": "#ffffff",
        "on_error": "#000000",
        "error_container": "#1c1c1c",
        "on_error_container": "#ffffff",
        "surface": "#000000",
        "on_surface": "#ffffff",
        "surface_variant": "#141414",
        "on_surface_variant": "#c0c0c0",
        "surface_dim": "#000000",
        "surface_bright": "#303030",
        "surface_container_lowest": "#000000",
        "surface_container_low": "#000000",
        "surface_container": "#0a0a0a",
        "surface_container_high": "#141414",
        "surface_container_highest": "#1c1c1c",
        "outline": "#3a3a3a",
        "outline_variant": "#1f1f1f",
        "scrim": "#000000",
        "shadow": "#000000"
    })

    // "Gruvbox" pack: Gruvbox dark. Bright accents on dim-accent containers
    // (the classic gruvbox fill), bg0..bg3 for the surface ladder.
    readonly property var gruvboxScheme: ({
        "primary": "#fabd2f",
        "on_primary": "#282828",
        "primary_container": "#d79921",
        "on_primary_container": "#282828",
        "secondary": "#8ec07c",
        "on_secondary": "#282828",
        "secondary_container": "#689d6a",
        "on_secondary_container": "#282828",
        "tertiary": "#d3869b",
        "on_tertiary": "#282828",
        "tertiary_container": "#b16286",
        "on_tertiary_container": "#282828",
        "error": "#fb4934",
        "on_error": "#282828",
        "error_container": "#cc241d",
        "on_error_container": "#fbf1c7",
        "surface": "#282828",
        "on_surface": "#ebdbb2",
        "surface_variant": "#504945",
        "on_surface_variant": "#bdae93",
        "surface_dim": "#1d2021",
        "surface_bright": "#3c3836",
        "surface_container_lowest": "#1d2021",
        "surface_container_low": "#282828",
        "surface_container": "#32302f",
        "surface_container_high": "#3c3836",
        "surface_container_highest": "#504945",
        "outline": "#928374",
        "outline_variant": "#504945",
        "scrim": "#000000",
        "shadow": "#000000"
    })

    // Palette source (ShellState.colorScheme). The fixed packs are merged over
    // the baseline, so roles they do not list keep sane defaults.
    readonly property var activeScheme: ShellState.colorScheme === "oled"
        ? Object.assign({}, root.baselineScheme, root.oledScheme)
        : ShellState.colorScheme === "gruvbox"
        ? Object.assign({}, root.baselineScheme, root.gruvboxScheme)
        : root.m3Scheme

    // The "new" pack layers its graphite surfaces on the wallpaper palette
    // only; a picked color scheme owns the surfaces.
    readonly property var scheme: root.glass && ShellState.colorScheme === "matugen"
        ? Object.assign({}, root.activeScheme, root.newScheme)
        : root.activeScheme

    FileView {
        id: colorsFile

        path: Qt.resolvedUrl("Colors.json")
        watchChanges: true
        printErrors: false

        onLoaded: root.applyGeneratedScheme()
        onFileChanged: colorsFile.reload()
        onTextChanged: root.applyGeneratedScheme()
    }

    // matugen emits 6-digit hex; tolerate 8-digit RRGGBBAA (QML wants AARRGGBB).
    function normalizeHex(value: string): string {
        if (value.length === 9 && value.charAt(0) === "#")
            return "#" + value.slice(7, 9) + value.slice(1, 7);
        return value;
    }

    function applyGeneratedScheme(): void {
        let data;
        try {
            data = JSON.parse(colorsFile.text());
        } catch (e) {
            console.warn("Theme: cannot parse Colors.json:", e);
            return;
        }
        const merged = Object.assign({}, root.baselineScheme);
        for (const key in data)
            merged[key] = root.normalizeHex(String(data[key]));
        root.m3Scheme = merged;
    }

    // ---- color roles (M3) ----------------------------------------------------

    readonly property color primary: scheme.primary
    readonly property color primaryText: scheme.on_primary
    readonly property color primaryContainer: scheme.primary_container
    readonly property color primaryContainerText: scheme.on_primary_container
    readonly property color secondary: scheme.secondary
    readonly property color secondaryText: scheme.on_secondary
    readonly property color secondaryContainer: scheme.secondary_container
    readonly property color secondaryContainerText: scheme.on_secondary_container
    readonly property color tertiary: scheme.tertiary
    readonly property color tertiaryText: scheme.on_tertiary
    readonly property color tertiaryContainer: scheme.tertiary_container
    readonly property color tertiaryContainerText: scheme.on_tertiary_container
    readonly property color error: scheme.error
    readonly property color errorText: scheme.on_error
    readonly property color errorContainer: scheme.error_container
    readonly property color errorContainerText: scheme.on_error_container
    readonly property color surface: scheme.surface
    readonly property color surfaceText: scheme.on_surface
    readonly property color surfaceVariant: scheme.surface_variant
    readonly property color surfaceVariantText: scheme.on_surface_variant
    readonly property color surfaceDim: scheme.surface_dim
    readonly property color surfaceBright: scheme.surface_bright
    readonly property color surfaceTint: scheme.surface_tint
    readonly property color primaryFixed: scheme.primary_fixed
    readonly property color primaryFixedDim: scheme.primary_fixed_dim
    readonly property color primaryFixedText: scheme.on_primary_fixed
    readonly property color primaryFixedVariantText: scheme.on_primary_fixed_variant
    readonly property color secondaryFixed: scheme.secondary_fixed
    readonly property color secondaryFixedDim: scheme.secondary_fixed_dim
    readonly property color secondaryFixedText: scheme.on_secondary_fixed
    readonly property color secondaryFixedVariantText: scheme.on_secondary_fixed_variant
    readonly property color tertiaryFixed: scheme.tertiary_fixed
    readonly property color tertiaryFixedDim: scheme.tertiary_fixed_dim
    readonly property color tertiaryFixedText: scheme.on_tertiary_fixed
    readonly property color tertiaryFixedVariantText: scheme.on_tertiary_fixed_variant
    readonly property color surfaceContainerLowest: scheme.surface_container_lowest
    readonly property color surfaceContainerLow: scheme.surface_container_low
    readonly property color surfaceContainer: scheme.surface_container
    readonly property color surfaceContainerHigh: scheme.surface_container_high
    readonly property color surfaceContainerHighest: scheme.surface_container_highest
    readonly property color outline: scheme.outline
    readonly property color outlineVariant: scheme.outline_variant
    readonly property color inverseSurface: scheme.inverse_surface
    readonly property color inverseOnSurface: scheme.inverse_on_surface
    readonly property color inversePrimary: scheme.inverse_primary
    readonly property color scrim: scheme.scrim
    readonly property color shadow: scheme.shadow

    // ---- state layers ----------------------------------------------------------

    // New restrains hover/focus feedback and darkens the modal scrim.
    readonly property real stateHover: root.glass ? 0.06 : 0.08
    readonly property real stateFocus: root.glass ? 0.08 : 0.12
    readonly property real statePressed: root.glass ? 0.10 : 0.12
    readonly property real stateDragged: root.glass ? 0.12 : 0.16
    readonly property real disabledContent: 0.38
    readonly property real disabledContainer: 0.12
    readonly property real scrimOpacity: root.glass ? 0.45 : 0.32

    // ---- shape scale (M3 Expressive: 4/8/12/16/20/28/32/48/full) ---------------

    readonly property int shapeXS: 4
    readonly property int shapeSM: 8
    readonly property int shapeMD: 12
    readonly property int shapeLG: 16
    readonly property int shapeLGI: root.glass ? 14 : 20 // large increased
    readonly property int shapeXL: root.glass ? 16 : 28
    readonly property int shapeXLI: root.glass ? 18 : 32 // extra large increased
    readonly property int shapeXXL: root.glass ? 22 : 48 // extra extra large (hero surfaces)
    readonly property int shapeFull: 9999

    // ---- style extras (New only; no-ops under m3) ------------------------------

    // Bar islands stop being pills under "new".
    readonly property int barRadius: root.glass ? 12 : shapeFull

    // Hairline edges: 0 width under m3, so borders can be added unconditionally.
    readonly property int hairlineWidth: root.glass ? 1 : 0
    // Outer edge stays faint; the bright edge is cardRim, one pixel inside it.
    readonly property color hairline: root.glass ? "#14ffffff" : "transparent"
    readonly property color cardRim: root.glass ? "#26ffffff" : "transparent"

    // Neutral drop shadow under cards, as RectangularShadow args. Invisible
    // over dark wallpaper, which is why every surface also draws cardRim.
    readonly property color cardShadow: root.glass ? "#66000000" : "transparent"
    readonly property int cardShadowBlur: 22
    readonly property int cardShadowOffset: 5


    // ---- motion ----------------------------------------------------------------
    // Emphasized-family easing curves from the M3 motion spec, as cubic bezier
    // control points for `easing.bezierCurve`.

    readonly property int durShort: 150 // state feedback, tooltips
    readonly property int durPop: 130 // expressive pop-out
    readonly property int durSettle: 220 // spring-back
    readonly property int durMorph: 240 // shape morphs (press)
    readonly property int durMedium: 250
    readonly property int durMedium3: 350 // M3E container morph
    readonly property int durLong: 400
    readonly property int durLong2: 500 // M3E shared-axis
    readonly property int durExtraLong: 700 // M3E container transform

    // ---- elevation (M3 levels; surfaces carry depth via container tones) -------

    readonly property int elevation0: 0
    readonly property int elevation1: 1
    readonly property int elevation2: 2
    readonly property int elevation3: 3
    readonly property int elevation4: 4
    readonly property int elevation5: 5

    // Overshoot for the spatial springs; QML has no real spring easing, so
    // Easing.OutBack with this factor stands in for the M3E spring curves.
    readonly property real springOvershoot: 1.3

    readonly property var curveEmphasized: [0.2, 0.0, 0.0, 1.0]
    readonly property var curveEmphasizedDecelerate: [0.05, 0.7, 0.1, 1.0]
    readonly property var curveEmphasizedAccelerate: [0.3, 0.0, 0.8, 0.15]

    // ---- typography ------------------------------------------------------------

    readonly property string fontFamily: "Google Sans"
    readonly property string iconFont: "Material Symbols Rounded"
    // Nerd Font symbols-only family; used by the few glyphs (like md-ornament
    // below) that Material Symbols does not carry.
    readonly property string nerdFont: "Symbols Nerd Font"
    readonly property int fontSizeDisplayLarge: 57
    readonly property int fontSizeDisplayMedium: 45
    readonly property int fontSizeDisplaySmall: 36
    readonly property int fontSizeHeadlineLarge: 32
    readonly property int fontSizeHeadlineMedium: 28
    readonly property int fontSizeHeadlineSmall: 24
    readonly property int fontSizeTitleLarge: 22
    readonly property int fontSizeTitleMedium: 16
    readonly property int fontSizeTitleSmall: 14
    readonly property int fontSizeBodyLarge: 16
    readonly property int fontSizeBodyMedium: 14
    readonly property int fontSizeBodySmall: 12
    readonly property int fontSizeLabelLarge: 14
    readonly property int fontSizeLabelMedium: 12
    readonly property int fontSizeLabelSmall: 11

    // ---- bar metrics -----------------------------------------------------------

    // New packs the bar one notch tighter.
    readonly property int barHeight: root.glass ? 36 : 40
    readonly property int barMargin: 4
    readonly property int barPadding: 4
    readonly property int chipHeight: root.glass ? 30 : 32
    readonly property int iconButtonSize: root.glass ? 30 : 32
    readonly property int iconSize: 20
    readonly property int iconSizeMedium: 24
    readonly property int iconSizeSmall: 16
    readonly property int iconSizeLarge: 30

    // ---- Material Symbols codepoints -------------------------------------------
    // Verified against the installed MaterialSymbolsRounded variable font.

    readonly property string iconVolumeDown: "\uE04D" // volume_down
    readonly property string iconVolumeMute: "\uE04E" // volume_mute
    readonly property string iconVolumeOff: "\uE04F" // volume_off
    readonly property string iconVolumeUp: "\uE050" // volume_up
    readonly property string iconBrightnessLow: "\uE1AD" // brightness_low
    readonly property string iconBrightnessMedium: "\uE1AE" // brightness_medium
    readonly property string iconBrightnessHigh: "\uE1AC" // brightness_high
    readonly property string iconKeyboard: "\uE312" // keyboard
    readonly property string iconPower: "\uE8AC" // power_settings_new
    readonly property string iconRestart: "\uF053" // restart_alt
    readonly property string iconLogout: "\uE9BA" // logout
    readonly property string iconLock: "\uE899" // lock
    readonly property string iconSuspend: "\uE1A2" // pause_circle
    readonly property string iconHibernate: "\uF159" // bedtime
    readonly property string iconCalendar: "\uE935" // calendar_today
    readonly property string iconNotifications: "\uE7F5" // notifications
    readonly property string iconNotificationsOff: "\uE7F6" // notifications_off
    readonly property string iconClock: "\uE8B5" // schedule
    readonly property string iconMonitoring: "\uF190" // monitoring
    readonly property string iconApps: "\uE5C3" // apps
    readonly property string iconCalculate: "\uEA5F" // calculate
    readonly property string iconSearch: "\uE8B6" // search
    readonly property string iconClose: "\uE5CD" // close
    readonly property string iconClipboard: "\uE14F" // content_paste
    readonly property string iconImage: "\uE3F4" // image
    readonly property string iconDelete: "\uE872" // delete
    readonly property string iconDeleteForever: "\uE92B" // delete_forever
    readonly property string iconBatteryCharging: "\uF205" // battery_charging_full
    readonly property string iconBatteryFull: "\uF304" // battery_full
    readonly property var iconBatteryBars: [ // battery_0_bar .. battery_6_bar
        "\uF306", "\uF30D", "\uF30C", "\uF30A", "\uF309", "\uF308", "\uF307"
    ]
    readonly property string iconWifi: "\uE63E" // wifi
    readonly property string iconWifiOff: "\uE648" // wifi_off
    readonly property string iconDnd: "\uE612" // do_not_disturb
    readonly property string iconNightlight: "\uEF5E" // nightlight
    readonly property string iconSettings: "\uE8B8" // settings
    readonly property string iconExpandMore: "\uE5CF" // expand_more
    readonly property string iconExpandLess: "\uE5CE" // expand_less
    readonly property string iconPlay: "\uE037" // play_arrow
    readonly property string iconPause: "\uE034" // pause
    readonly property string iconNext: "\uE044" // skip_next
    readonly property string iconPrevious: "\uE045" // skip_previous
    readonly property string iconMusic: "\uE3A1" // music_note
    readonly property string iconStar: "\uE838" // star
    readonly property string iconShuffle: "\uE043" // shuffle
    readonly property string iconOrnament: "\udb80\udfcc" // md-ornament (Symbols Nerd Font)

    // Weather: classic codepoints, glyphs verified by render against the
    // installed MaterialSymbolsRounded font.
    readonly property string iconSunny: "\uE430" // wb_sunny
    readonly property string iconPartlyCloudy: "\uE42D" // wb_cloudy
    readonly property string iconCloud: "\uE2BD" // cloud
    readonly property string iconRain: "\uE798" // water_drop
    readonly property string iconSnow: "\uEB3B" // ac_unit
    readonly property string iconStorm: "\uE3E7" // flash_on
